{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chinese-poetry-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "vars": {}
}
