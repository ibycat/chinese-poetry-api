{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chinese-poetry-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["RateLimiter"]
    }
  ],
  "vars": {}
}
