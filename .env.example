# 无头运行所需的凭据（复制为 .env 后填写；.env 已在 .gitignore 中忽略）

# 模型网关：兼容 OpenAI /chat/completions 的地址，不带结尾斜杠
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=
# 默认标注模型，可被 --model 覆盖
LLM_MODEL=cn:deepseek-v4.1-flash

# Cloudflare 部署（wrangler 直接读这两个变量）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# 需要代理才能访问 GitHub / Cloudflare 时填，例如 http://127.0.0.1:7890
# HTTPS_PROXY=
# HTTP_PROXY=
